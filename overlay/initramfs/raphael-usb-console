#!/bin/sh
# USB ACM 串口控制台（调试）：等 UDC 最多 60s，反复重试
msg() { echo "raphael-usb: $*" > /dev/kmsg 2>/dev/null; echo "raphael-usb: $*" > /dev/console 2>/dev/null; }

[ -d /sys ] || mount -t sysfs none /sys 2>/dev/null
[ -d /proc ] || mount -t proc none /proc 2>/dev/null
[ -e /dev/null ] || mount -t devtmpfs none /dev 2>/dev/null
mkdir -p /sys/kernel/config
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config 2>/dev/null || { msg "configfs fail"; exit 0; }

G=/sys/kernel/config/usb_gadget/raphael
rm -rf "$G" 2>/dev/null
mkdir -p "$G" || { msg "gadget mkdir fail"; exit 0; }
echo 0x1d6b > "$G/idVendor"
echo 0x0104 > "$G/idProduct"
echo 0x0100 > "$G/bcdDevice"
mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0"
echo "raphael" > "$G/strings/0x409/manufacturer"
echo "raphael console" > "$G/strings/0x409/product"
echo "raphael" > "$G/strings/0x409/serialnumber"
echo "ACM" > "$G/configs/c.1/strings/0x409/configuration"
ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null

i=0
while [ $i -lt 120 ]; do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    if [ -n "$UDC" ]; then
        if echo "$UDC" > "$G/UDC" 2>/dev/null; then
            msg "acm console bound to $UDC after $((i/2))s"
            # 给串口一个 shell，即便没有 console=ttyGS0 也能交互
            ( sleep 2; exec sh -c 'exec setsid sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1' ) >/dev/null 2>&1 &
            exit 0
        fi
    fi
    i=$((i+1)); sleep 0.5
done
msg "no UDC bound (timeout)"
exit 0

